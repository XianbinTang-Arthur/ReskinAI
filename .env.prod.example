# ReSkin AI production environment example
# Copy to .env.prod on your server and replace placeholder values.

APP_ENV=prod
APP_PORT=8000
APP_BIND_IP=127.0.0.1

POSTGRES_DB=reskinai
POSTGRES_USER=reskinai
POSTGRES_PASSWORD=replace_with_strong_password

MODEL_PROVIDER=auto
MODEL_FALLBACK_ENABLED=true
MODEL_RETRY_ATTEMPTS=1
MODEL_REQUEST_TIMEOUT_SECONDS=110

OPENAI_API_KEY=replace_with_your_openai_key
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_EDIT_MODEL=dall-e-2
OPENAI_IMAGE_SIZE=1024x1024

MODEL_VERSION=managed-image-v1
PROMPT_VERSION=prompt-v1
SAFETY_POLICY_VERSION=safety-v1

MAX_GENERATION_VARIANTS=5
MAX_UPLOAD_SIZE_BYTES=5242880
RUN_MIGRATIONS=1
